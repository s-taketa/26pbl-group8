# AI見守りアシスタント - 環境変数設定テンプレート
# 本ファイルを参考に、.env ファイルを作成してください

# Google Gemini API キー
# https://ai.google.dev から API キーを取得
GOOGLE_GEMINI_API_KEY=AIzaSyCLw5ve_bP-SwNIHMxTlvWmJ0DwCI4Tmq0
# MySQL 設定
# ルートパスワード
MYSQL_ROOT_PASSWORD=rootpassword

# アプリケーション用 MySQL ユーザー
DB_USER=ai_assistant
DB_PASSWORD=changeme
DB_NAME=ai_assistant_db

# Flask 環境設定
# 開発環境: development
# 本番環境: production
FLASK_ENV=production

# VOICEVOX 設定
# docker-compose 内の場合は voicevox に設定
VOICEVOX_HOST=voicevox
VOICEVOX_PORT=50021

# Raspberry Pi 固有設定（オプション）
# カメラデバイス番号
CAMERA_DEVICE=/dev/video0

# エッジ(Pi)のリアルタイム映像URL（ダッシュボードに埋め込む）
# 例: http://192.168.100.15:5002 （PiのIP:5002）。未設定なら映像は表示されない。
EDGE_URL=http://192.168.100.30:5002 

# ログレベル
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 認証コードのメール送信（Gmail SMTP）
# Gmailの場合: 2段階認証をONにし「アプリパスワード」を発行して SMTP_PASS に設定する。
# 未設定の場合、認証コードはサーバーログに出力されます（送信はされません）。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=saamonn1818@gmail.com
SMTP_PASS=vzsa rkfp utep exrt
SMTP_FROM=saamonn1818@gmail.com

# LINE Messaging API（家族への通知 / 緊急アラート・会話ログ・定期通知）
# LINE Developers でMessaging APIチャネルを作成し、長期チャネルアクセストークンを取得して設定。
# LINE_USER_ID は通知の宛先ユーザーID（Uxxxxxxxx）。未設定なら通知は送信されない。
LINE_CHANNEL_ACCESS_TOKEN=ojAa+93cWqpSwYrmeMiwA7vJ1MuZ7o+vcpmrMIcw0wvGtbDevSMt3qyNe9CIvJ5jsHAfD33CfGHWVPKULLddLcScTf6OcWR/XHWwQkbTILH8HTkPBiLshXpEvlyPLd5RgFAug7zxUb1haakBxxp2iwdB04t89/1O/w1cDnyilFU=
LINE_USER_ID=U4d8d82ab35e42a3dcf29471cd48d970a

# 定期通知の間隔（分）。notify_periodic がONのときに使用
PERIODIC_NOTIFY_MINUTES=60