# AI見守りアシスタント - 環境変数設定テンプレート
# 本ファイルを参考に、.env ファイルを作成してください

# Google Gemini API キー
# https://ai.google.dev から API キーを取得
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key-here

# MySQL 設定
# ルートパスワード
MYSQL_ROOT_PASSWORD=rootpassword

# アプリケーション用 MySQL ユーザー
DB_USER=ai_assistant
DB_PASSWORD=changeme
DB_NAME=ai_assistant_db

# Flask 環境設定
# 開発環境: development
# 本番環境: production
FLASK_ENV=production

# VOICEVOX 設定
# docker-compose 内の場合は voicevox に設定
VOICEVOX_HOST=voicevox
VOICEVOX_PORT=50021

# Raspberry Pi 固有設定（オプション）
# カメラデバイス番号
CAMERA_DEVICE=/dev/video0

# ログレベル
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO